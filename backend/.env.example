# Backend only. Never put these values in VITE_* variables or commit a populated .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REMEMBER_ME_EXPIRE_DAYS=7

# Explicit opt-in; leave disabled until every setting and Redis are ready.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_COMPLETION_URL=http://localhost:5173/auth/google/callback

# Use rediss:// with TLS and ACL credentials for a remote Redis service.
# Plain redis:// is allowed only for a loopback endpoint.
REDIS_URL=
# A separately generated Fernet key; identical on all backend workers.
OAUTH_TRANSACTION_KEY=
# Production must use HTTPS and true. False is accepted only for loopback URLs.
OAUTH_COOKIE_SECURE=true
# Optional: absolute private persistent directory, never a public/static mount.
# Defaults to backend/private/profile-pictures; service directory requires mode 0700.
# PROFILE_IMAGE_DIR=/absolute/private/frameora/profile-pictures
# Stage 4 gates: leave false until migration 002 is separately approved/applied.
# Once version checks are activated, do not turn them off as a rollback.
AUTH_VERSION_ENABLED=false
# Can be disabled independently while retaining auth_version revocation checks.
PASSWORD_MANAGEMENT_ENABLED=false

# AI generation stays disabled until explicitly enabled after configuration.
# Set the secret in the process environment or backend/.env; never in VITE_*.
POLLINATIONS_ENABLED=false
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=openai/gpt-image-1-mini
POLLINATIONS_TIMEOUT_SECONDS=180
# Suggestions use the Chat Completions endpoint and do not require image generation to be enabled.
POLLINATIONS_CHAT_MODEL=openai/gpt-5.4-nano
POLLINATIONS_CHAT_TIMEOUT_SECONDS=45
# Optional absolute private directory, mode 0700 (default backend/private/ai-images).
# AI_IMAGE_DIR=

# Live Pose Guide: keep off until separately approved live vision verification.
LIVE_POSE_VISION_ENABLED=false
