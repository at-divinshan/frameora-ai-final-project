{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "/oauth-api/auth/google/(start|callback|complete|register|link/start|link/complete|password-setup/start|password-setup/complete)",
      "dest": "https://frameora-ai-final-project-production.up.railway.app/auth/google/$1",
      "headers": {
        "Cache-Control": "no-store",
        "Pragma": "no-cache"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
